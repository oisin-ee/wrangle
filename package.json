{
  "name": "wrangle",
  "version": "0.1.1",
  "description": "Admit, queue, and spawn coding agents across Herdr hosts. Pi tool, CLI, Herdr plugin, and skill.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oisin-ee/wrangle.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "herdr",
    "agents",
    "orchestration"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"pi/**/*.test.ts\""
  },
  "pi": {
    "extensions": ["./pi/index.ts"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "26.6.4",
    "typebox": "1.3.36",
    "typescript": "7.0.2"
  }
}
